/* components/tide-station-map/tide-station-map.wxss */

.tide-station-map {
  position: relative;
  width: 100%;
  /* 高度由父页面通过内联 style 动态设置 */
}

.map {
  width: 100%;
  height: 100%;
  min-height: 400rpx;
}

/* 定位按钮 */
.locate-btn {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 50%;
  width: 80rpx;
  height: 80rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  z-index: 30;
}

.locate-icon {
  font-size: 36rpx;
}

/* 站点弹窗（居中偏上） */
.map-popup {
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.18);
  padding: 24rpx;
  overflow: hidden;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.popup-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.popup-text {
  font-size: 26rpx;
  color: #666;
}

.popup-rec {
  color: #FF6B4A !important;
  font-weight: 600;
}

.popup-mock {
  text-align: center;
  font-size: 20rpx;
  color: #FF9800;
  padding-top: 8rpx;
}

.popup-close {
  text-align: center;
  padding: 16rpx 0 0;
  margin-top: 12rpx;
  border-top: 1rpx solid #F0F0F0;
  color: #999;
  font-size: 26rpx;
}
