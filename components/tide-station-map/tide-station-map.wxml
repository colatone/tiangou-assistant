<!-- components/tide-station-map/tide-station-map.wxml -->
<view class="tide-station-map" style="height: {{mapHeight}}px;">

  <!-- 腾讯地图 -->
  <map
    id="tideStationMap"
    class="map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    subkey="{{mapKey}}"
    bindmarkertap="onMarkerTap"
  ></map>

  <!-- 站点弹窗 -->
  <view class="map-popup" wx:if="{{showPopup && popupStation}}">
    <view class="popup-card">
      <view class="popup-title">{{popupStation.name}}</view>
      <view class="popup-info" wx:if="{{popupTide}}">
        <text class="popup-text">{{popupTide.nextTide}}</text>
        <text class="popup-text popup-rec">{{popupTide.recommend}}</text>
      </view>
      <view class="popup-mock" wx:if="{{popupTide && popupTide.mock}}">* 示例数据</view>
      <view class="popup-close" bindtap="onClosePopup">关闭</view>
    </view>
  </view>

  <!-- 定位按钮 -->
  <view class="locate-btn" bindtap="onLocateMe">
    <text class="locate-icon">📍</text>
  </view>

</view>
