/* pages/typhoon/typhoon.wxss */

.storm-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.storm-list {
  display: inline-flex;
  gap: 12rpx;
}

/* 风暴切换标签（与首页 .category-tag 视觉统一） */
.storm-tag {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-lg);
  background: var(--bg-white);
  color: var(--text-secondary);
  font-size: 24rpx;
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-card);
}

.storm-tag.active {
  background: #FF8C6920;
  color: var(--color-primary);
  border-color: var(--color-primary);
  font-weight: 500;
}

/* 加载态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 48rpx;
  color: var(--text-tertiary);
}

.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid var(--color-primary-light);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
}

/* 演示数据提示 */
.mock-tip {
  margin-top: 8rpx;
  padding: 16rpx 24rpx;
  background: #FFF8E1;
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  color: #E65100;
  text-align: center;
}

/* 更新时间提示 */
.update-bar {
  padding: 14rpx 24rpx;
  background: #FFFFFF;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  font-size: 24rpx;
  color: var(--text-secondary);
}
