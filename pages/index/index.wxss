/* pages/index/index.wxss */

.quote-card {
  background: linear-gradient(135deg, #FF8C69, #FF6B6B);
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.2);
}

.quote-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.quote-text {
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1.6;
  flex: 1;
}

.filter-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.category-scroll {
  flex: 1;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 12rpx;
}

.category-tag {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-lg);
  background: var(--bg-white);
  color: var(--text-secondary);
  font-size: 24rpx;
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-card);
  transition: all 0.2s;
}

.category-tag.active {
  background: #FF8C6920;
  color: var(--color-primary);
  border-color: var(--color-primary);
  font-weight: 500;
}

.sort-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  font-size: 24rpx;
  color: var(--text-secondary);
  box-shadow: var(--shadow-card);
  flex-shrink: 0;
}

.sort-arrow {
  margin-left: 8rpx;
  color: var(--color-primary);
  font-size: 22rpx;
}

.event-list {
  padding-bottom: 120rpx;
}

.event-card {
  background: var(--bg-white);
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
}

.event-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  border-radius: 3rpx 0 0 3rpx;
}

.event-card.elapsed::before {
  background: linear-gradient(180deg, #FF8C69, #FF6B6B);
}

.event-card.countdown::before {
  background: linear-gradient(180deg, #6ECBF5, #4A90D9);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.event-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  word-break: break-all;
}

.category-badge {
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.card-body {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

/* ===== 正计时天数显示 ===== */
.days-number {
  display: flex;
  align-items: baseline;
}

.days-number .number {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
}

.days-number .unit {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-left: 8rpx;
}

/* ===== 倒计时详细显示 ===== */
.countdown-display {
  display: flex;
  align-items: baseline;
}

.countdown-main {
  display: flex;
  align-items: baseline;
}

.time-block {
  display: inline-flex;
  align-items: baseline;
  margin-right: 4rpx;
}

.time-block .time-value {
  font-size: 64rpx;
  font-weight: 700;
  color: #4A90D9;
  line-height: 1;
  min-width: 60rpx;
  text-align: center;
}

.time-block .time-unit {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-left: 2rpx;
}

.time-block.small .time-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #6ECBF5;
  min-width: 40rpx;
  text-align: center;
}

.time-block.small .time-unit {
  font-size: 18rpx;
}

.time-sep {
  font-size: 36rpx;
  color: #CCCCCC;
  font-weight: 300;
  margin: 0 2rpx;
}

.expired-badge {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-success);
  padding: 8rpx 24rpx;
  background: #F0FFF0;
  border-radius: 30rpx;
}

/* ===== 日期信息（含农历） ===== */
.date-info {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.date-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-bottom: 4rpx;
}

.date-value {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 农历标签 */
.lunar-tag {
  margin-top: 4rpx;
  padding: 2rpx 10rpx;
  background: #FFF5EE;
  border-radius: 8rpx;
}

.lunar-tag text {
  font-size: 20rpx;
  color: #A0522D;
}

/* 高亮标签（节气/节日） */
.highlight-tag-mini {
  margin-top: 4rpx;
  padding: 2rpx 12rpx;
  background: linear-gradient(135deg, #FFEBEE, #FFF3E0);
  border-radius: 10rpx;
}

.highlight-tag-mini text {
  font-size: 18rpx;
  color: #E65100;
  font-weight: 500;
}

/* ===== 提醒标记 ===== */
.reminder-mark {
  display: flex;
  justify-content: center;
  padding: 8rpx 0;
  border-top: 1rpx dashed #EEE;
  margin-top: 12rpx;
}

.reminder-mark text {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* ===== 卡片底部 ===== */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #F0F0F0;
  padding-top: 16rpx;
}

.note {
  font-size: 24rpx;
  color: var(--text-tertiary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F5F5F5;
  font-size: 28rpx;
}

.action-btn:active {
  opacity: 0.7;
}

.float-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8C69, #FF6B6B);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.35);
  z-index: 100;
}

.float-btn:active {
  transform: scale(0.95);
}

.float-icon {
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

/* 空状态 */
.empty-state {
  padding: 160rpx 48rpx;
  text-align: center;
}

.empty-state .icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-state .text {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.empty-state .sub-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
  display: block;
}

.restore-btn {
  margin-top: 40rpx;
  display: inline-block;
  padding: 18rpx 40rpx;
  background: #FFF3ED;
  color: #FF8C69;
  border: 1rpx solid #FFD9BF;
  border-radius: 40rpx;
  font-size: 28rpx;
}
.restore-btn:active {
  transform: scale(0.96);
}
