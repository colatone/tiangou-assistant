/* ═══ 烂番茄统计 ═══ */
.page {
  min-height: 100vh;
  background: var(--bg-primary, #FFF8F0);
  padding: 30rpx 30rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ── 汇总卡 ── */
.summary {
  display: flex;
  gap: 18rpx;
  margin-bottom: 36rpx;
}
.sum-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.sum-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-primary, #FF8C69);
}
.sum-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* ── 列表 ── */
.section-title {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 18rpx;
}
.heat-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 10rpx 24rpx;
  box-sizing: border-box;
}
.heat-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
}
.heat-date {
  width: 76rpx;
  font-size: 22rpx;
  color: #999999;
  flex-shrink: 0;
}
.heat-bar-wrap {
  flex: 1;
  height: 20rpx;
  background: #F6F3EF;
  border-radius: 10rpx;
  overflow: hidden;
}
.heat-bar {
  height: 100%;
  min-width: 0;
  background: var(--color-primary, #FF8C69);
  border-radius: 10rpx;
}
.heat-count {
  width: 64rpx;
  font-size: 22rpx;
  color: #999999;
  text-align: right;
  flex-shrink: 0;
}

/* ── 空状态 ── */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 90rpx 0;
  color: #BBBBBB;
  font-size: 26rpx;
}
.empty-sub {
  font-size: 22rpx;
  color: #CCCCCC;
}
