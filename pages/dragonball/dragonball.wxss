/* pages/dragonball/dragonball.wxss —— 复用 MUJI 浅色 + 暖橙点缀 */

.seg {
  display: flex;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-radius: var(--radius-md);
  transition: all .2s;
}
.seg-item.active {
  background: linear-gradient(135deg, #FF8C69, #FF6B6B);
  color: #FFFFFF;
  font-weight: 600;
}

.error-bar {
  background: #FFF3E0;
  color: #E65100;
  font-size: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-md);
  margin-bottom: 20rpx;
}

/* 最新现世（与「我的龙珠阵」一致的紧凑行） */
.latest-row { align-items: flex-start; }
.latest-meta { margin-left: auto; display: flex; flex-direction: column; align-items: flex-end; }
.lm-seq { font-size: 26rpx; color: var(--text-primary); font-weight: 500; }
.lm-date { font-size: 20rpx; color: var(--text-tertiary); margin-top: 4rpx; }

/* 龙珠球 */
.balls { display: flex; flex-wrap: wrap; gap: 12rpx; }
.ball {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700; color: #FFFFFF;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.12);
}
.ball.sm { width: 56rpx; height: 56rpx; font-size: 22rpx; }
.main-ball { background: linear-gradient(135deg, #FF7A7A, #FF5A5A); }
.sub-ball { background: linear-gradient(135deg, #7FD4F5, #6ECBF5); }

/* 状态条 */
.track-bar {
  display: flex; align-items: center;
  font-size: 22rpx; color: var(--text-tertiary);
  padding: 12rpx 8rpx 20rpx;
}
.dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #CCCCCC; margin-right: 10rpx;
}
.dot.on { background: var(--color-success); box-shadow: 0 0 8rpx var(--color-success); }

/* 区块标题 */
.sec-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary); }
.seq-tag { font-size: 22rpx; font-weight: 500; color: var(--color-primary); background: rgba(255,107,107,0.10); padding: 2rpx 14rpx; border-radius: 20rpx; margin-left: 12rpx; }
.sec-sub { display: block; font-size: 22rpx; color: var(--text-tertiary); margin: 6rpx 0 20rpx; }

/* 热门/冷门 */
.hotcold { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; margin-bottom: 20rpx; }
.hc-label { font-size: 22rpx; color: var(--text-secondary); margin-left: 10rpx; }
.hc-label:first-child { margin-left: 0; }
.hc-tag {
  font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 20rpx;
}
.hc-tag.hot { background: #FFE8E0; color: #FF6B6B; }
.hc-tag.cold { background: #E8F4FB; color: #6ECBF5; }

/* 指引组（与「我的龙珠阵」一致的紧凑行） */
.guides { margin-bottom: 12rpx; }
.guide-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 0; border-bottom: 1rpx solid #F2F2F2;
}
.guide-row .balls { flex-wrap: nowrap; gap: 22rpx; }
.guide-row .ball { width: 66rpx; height: 66rpx; font-size: 26rpx; }

.guide-actions { display: flex; gap: 16rpx; }
.btn-s {
  flex: 1; font-size: 26rpx; padding: 18rpx 0; border-radius: var(--radius-lg);
  text-align: center; line-height: 1.5;
}
.btn-s {
  background: #FFFFFF; color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}
.btn-s::after { border: none; }
.btn-disabled { background: #F2F2F2 !important; color: #B0B0B0 !important; border-color: #E5E5E5 !important; }

/* 龙珠阵 */
.empty-tip { font-size: 24rpx; color: var(--text-tertiary); padding: 24rpx 0; text-align: center; }
.follow-group { margin-bottom: 8rpx; }
.follow-group:not(:last-child) { border-bottom: 8rpx solid #FAF3EC; padding-bottom: 8rpx; }
.fg-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14rpx 0 6rpx; margin-top: 4rpx;
}
.fg-head:first-child { margin-top: 0; }
.fg-seq { font-size: 24rpx; font-weight: 600; color: #E65100; }
.fg-date { font-size: 22rpx; color: var(--text-tertiary); }
.follow-row {
  display: flex; align-items: center; gap: 12rpx;
  padding: 14rpx 0; border-bottom: 1rpx solid #F2F2F2;
}
.follow-status { margin-left: auto; font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 20rpx; }
.follow-status.pending { background: #FFF3E0; color: #E65100; }
.follow-status.all { background: #FFE8D6; color: #FF6B6B; }
.follow-status.part { background: #E8F6E8; color: var(--color-success); }
.follow-status.miss { background: #F2F2F2; color: #999999; }

/* 署名 + 免责 */
.attr { text-align: center; font-size: 20rpx; color: var(--text-tertiary); margin-top: 24rpx; }
.disclaimer { text-align: center; font-size: 20rpx; color: #CCCCCC; margin-top: 8rpx; padding-bottom: 40rpx; }

/* 隐藏分享画布 */
.share-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 600rpx;
  height: 1080rpx;
}

/* 底部菜单栏占位（避免被覆盖） */
.tabbar-placeholder { height: calc(100rpx + env(safe-area-inset-bottom)); }
