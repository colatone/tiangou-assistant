/* pages/share-card/share-card.wxss */

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-primary);
}

.preview-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 48rpx 0;
  position: relative;
}

.loading-tip {
  position: absolute;
  color: var(--text-tertiary);
  font-size: 26rpx;
}

.share-canvas {
  /* 加高以容纳小程序码 */
  width: 640rpx;
  height: 1080rpx;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-float);
}

.action-bar {
  width: 100%;
  padding: 24rpx 0 48rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-bar .btn-primary,
.action-bar .btn-secondary {
  margin: 0;
}

.action-bar .btn-secondary {
  background: var(--bg-white);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.action-bar .btn-secondary::after {
  border: none;
}
