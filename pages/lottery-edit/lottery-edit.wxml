<!-- pages/lottery-edit/lottery-edit.wxml — 设置页（浅色主题） -->
<view class="page-edit">

  <!-- 顶部标签栏 -->
  <view class="tab-bar">
    <view class="tab-item {{currentTab==='people'?'on':''}}" bindtap="onSwitchTab" data-tab="people">
      <text>人员列表</text>
    </view>
    <view class="tab-item {{currentTab==='prizes'?'on':''}}" bindtap="onSwitchTab" data-tab="prizes">
      <text>奖项配置</text>
    </view>
    <view class="tab-item {{currentTab==='records'?'on':''}}" bindtap="onSwitchTab" data-tab="records">
      <text>抽签记录</text>
    </view>
  </view>

  <!-- 内容区 -->
  <scroll-view class="content-scroll" scroll-y enhanced show-scrollbar="{{false}}">

    <!-- ===== 人员列表 ===== -->
    <block wx:if="{{currentTab === 'people'}}">
      <view class="card">
        <view class="card-head">
          <text class="card-title">参与人员（{{editPeople.length}}）</text>
          <text class="card-add" bindtap="toggleBatchInput">🔢 按人数批量添加</text>
        </view>

        <!-- 批量添加输入（展开时显示） -->
        <view class="batch-input-row" wx:if="{{showBatchInput}}">
          <input class="batch-num" type="digit" placeholder="输入人数(1-200)"
                 value="{{batchCount}}" bindinput="onBatchCountInput" />
          <button class="btn-batch-go" catchtap="onBatchAdd">生成</button>
          <button class="btn-batch-cancel" catchtap="toggleBatchInput">取消</button>
        </view>

        <!-- 人员列表 -->
        <view class="person-list">
          <view class="person-item" wx:for="{{editPeople}}" wx:key="id">
            <view class="pi-avatar" style="background:{{item.color}}">{{item.name ? item.name[0] : '?'}}</view>
            <input class="pi-name" value="{{item.name}}" placeholder="输入姓名"
                   bindinput="onPersonNameInput" data-index="{{index}}" />
            <view class="pi-del" bindtap="onDeletePerson" data-index="{{index}}">
              <text>✕</text>
            </view>
          </view>
        </view>

        <view class="add-row" bindtap="onAddPerson">＋ 添加人员</view>

        <view class="btn-row">
          <button class="btn-primary flex-1" bindtap="onSavePeople">保存</button>
          <button class="btn-reset" bindtap="onResetPeople">重置默认</button>
        </view>
      </view>
    </block>

    <!-- ===== 奖项配置 ===== -->
    <block wx:if="{{currentTab === 'prizes'}}">
      <view class="card">
        <view class="card-head">
          <text class="card-title">奖项列表（{{editPrizes.length}}）</text>
          <text class="card-add" bindtap="onTemplateAdd">📋 按模板批量添加</text>
        </view>

        <view class="prize-list">
          <view class="prize-item" wx:for="{{editPrizes}}" wx:key="id">
            <view class="pri-top">
              <view class="pri-icon-btn" style="background:#F8F8F8;border-color:#EEEEEE"
                    bindtap="onOpenEmoji" data-index="{{index}}">
                <text>{{item.icon}}</text>
              </view>
              <input class="pri-name" value="{{item.name}}" placeholder="奖项名称"
                     bindinput="onNameInput" data-index="{{index}}" />
              <view class="pri-del" bindtap="onDelete" data-index="{{index}}"><text>✕</text></view>
            </view>
            <view class="pri-bottom">
              <view class="pri-field">
                <text class="pri-lbl">总数量</text>
                <input class="pri-num" type="digit"
                       value="{{item.quantity}}"
                       bindinput="onQtyInput" data-index="{{index}}" />
              </view>
              <view class="pri-field">
                <text class="pri-lbl">每次抽几人</text>
                <input class="pri-num" type="digit"
                       value="{{item.drawCount}}"
                       bindinput="onDrawCountInput" data-index="{{index}}" />
              </view>
              <view class="pri-field">
                <text class="pri-lbl">优先级</text>
                <input class="pri-num" type="digit"
                       value="{{item.weight}}"
                       bindinput="onWeightInput" data-index="{{index}}" />
              </view>
            </view>
          </view>
        </view>

        <view class="add-row" bindtap="onAddPrize">＋ 添加奖项</view>

        <view class="btn-row">
          <button class="btn-primary flex-1" bindtap="onSavePrizes">保存</button>
          <button class="btn-reset" bindtap="onResetPrizes">重置默认</button>
        </view>
      </view>
    </block>

    <!-- ===== 抽签记录 ===== -->
    <block wx:if="{{currentTab === 'records'}}">
      <view class="card">
        <view class="card-head">
          <text class="card-title">抽签记录 ({{recordTotal}})</text>
          <text class="act-link danger" bindtap="onResetRec">重置</text>
        </view>

        <view class="rec-list" wx:if="{{recordList.length}}">
          <view class="rec-item" wx:for="{{recordList}}" wx:key="id">
            <text class="rec-icon">{{item.prizeIcon}}</text>
            <view class="rec-body">
              <text class="rec-name">{{item.personName}}</text>
              <text class="rec-meta" style="color:{{item.prizeColor}}">{{item.prizeName}} · {{item.time || ''}}</text>
            </view>
          </view>
        </view>
        <view wx:else class="empty-state">
          <text class="empty-icon">📋</text>
          <text class="empty-text">暂无抽签记录</text>
        </view>
      </view>
    </block>

  </scroll-view>

  <!-- emoji 选择器 -->
  <view class="emoji-sheet" wx:if="{{emojiFor >= 0}}" bindtap="onCloseEmoji">
    <view class="emoji-grid" catchtap="noop">
      <text wx:for="{{emojiOpts}}" wx:key="*this" class="emi-item"
            catchtap="onPickEmoji" data-emoji="{{item}}">{{item}}</text>
    </view>
  </view>

  <custom-tabbar current="lottery" />
</view>
