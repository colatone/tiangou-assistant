/* pages/lottery-edit/lottery-edit.wxss — 设置页（浅色主题） */
page { background: #FFF8F0; }

.page-edit {
  min-height: 100vh;
  background: #FFF8F0;
  display: flex;
  flex-direction: column;
}

/* ===== 顶部标签栏 ===== */
.tab-bar {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0EDE8;
  padding: 0 12rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #999999;
  font-weight: 500;
  position: relative;
}
.tab-item.on {
  color: #FF8C69;
  font-weight: 700;
}
.tab-item.on::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  right: 25%;
  height: 5rpx;
  background: linear-gradient(90deg, transparent, #FF8C69, transparent);
  border-radius: 3rpx;
}

/* ===== 内容滚动区 ===== */
.content-scroll {
  flex: 1;
  padding: 20rpx 24rpx calc(20rpx + 100rpx + env(safe-area-inset-bottom));
}

/* ===== 卡片 ===== */
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
}
.card-add {
  font-size: 26rpx;
  color: #FF8C69;
  font-weight: 600;
}
.act-link {
  font-size: 26rpx;
  color: #FF8C69;
  font-weight: 500;
}
.act-link.danger { color: #FF6B6B; }

/* ===== 批量添加区域 ===== */
.batch-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  background: #FAFAFA;
  border-radius: 14rpx;
  border: 1rpx solid #EEEEEE;
}
.batch-num {
  flex: 1;
  height: 64rpx;
  background: #FFFFFF;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  color: #333333;
  text-align: center;
  border: 1rpx solid #EEEEEE;
}
.btn-batch-go {
  width: 120rpx !important;
  height: 64rpx !important;
  line-height: 64rpx !important;
  font-size: 26rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  background: #FF8C69 !important;
  color: #FFF !important;
  border-radius: 12rpx !important;
  border: none !important;
}
.btn-batch-go::after { border: none; }
.btn-batch-cancel {
  width: 100rpx !important;
  height: 64rpx !important;
  line-height: 64rpx !important;
  font-size: 24rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  background: #F0F0F0 !important;
  color: #888 !important;
  border-radius: 12rpx !important;
  border: none !important;
}
.btn-batch-cancel::after { border: none; }

/* ===== 人员列表 ===== */
.person-list {}
.person-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F7F5F2;
}
.person-item:last-child { border-bottom: none; }
.pi-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #FFF;
  flex-shrink: 0;
}
.pi-name {
  flex: 1;
  min-width: 180rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  font-size: 28rpx;
  color: #333333;
  border: 1rpx solid #EEEEEE;
}
.pi-del {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #CCCCCC;
  flex-shrink: 0;
}

/* ===== 奖项配置（数量+drawCount） ===== */
.prize-list {}
.prize-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F7F5F2;
}
.prize-item:last-child { border-bottom: none; }
.pri-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.pri-icon-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid;
  font-size: 36rpx;
  flex-shrink: 0;
}
.pri-name {
  flex: 1;
  background: #FAFAFA;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  font-size: 28rpx;
  color: #333333;
  border: 1rpx solid #EEEEEE;
}
.pri-del {
  width: 56rpx;
  text-align: center;
  font-size: 28rpx;
  color: #CCCCCC;
  flex-shrink: 0;
}
.pri-bottom {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 14rpx;
  padding-left: 82rpx;
}
.pri-field {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.pri-lbl {
  font-size: 23rpx;
  color: #AAAAAA;
  white-space: nowrap;
  flex-shrink: 0;
}
.pri-num {
  width: 100%;
  min-width: 80rpx;
  background: #FAFAFA;
  border-radius: 10rpx;
  padding: 10rpx 12rpx;
  font-size: 26rpx;
  color: #333333;
  text-align: center;
  border: 1rpx solid #EEEEEE;
}

/* ===== 添加行 ===== */
.add-row {
  text-align: center;
  padding: 22rpx;
  margin-top: 16rpx;
  border: 2rpx dashed rgba(255,140,105,0.3);
  border-radius: 14rpx;
  color: #FF8C69;
  font-size: 27rpx;
}

/* ===== 按钮行：保存 + 重置 ===== */
.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.flex-1 { flex: 1; }

/* 主按钮（保存）—— 居中文字，更好看 */
.btn-primary {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  background: linear-gradient(135deg, #FF8C69, #FF6B4A);
  color: #FFF;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  box-shadow: 0 6rpx 20rpx rgba(255,107,74,0.22);
  border: none;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}
.btn-primary::after { border: none; }

/* 重置按钮 */
.btn-reset {
  width: 160rpx !important;
  height: 84rpx !important;
  line-height: 84rpx !important;
  background: #F5F3F0 !important;
  color: #999999 !important;
  border-radius: 42rpx !important;
  font-size: 26rpx !important;
  font-weight: 600;
  border: 1rpx solid #EEEEEE !important;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}
.btn-reset::after { border: none; }

/* ===== 记录 ===== */
.rec-list {}
.rec-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F7F5F2;
}
.rec-item:last-child { border-bottom: none; }
.rec-icon { font-size: 36rpx; flex-shrink: 0; }
.rec-body { flex: 1; min-width: 0; }
.rec-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
}
.rec-meta {
  font-size: 23rpx;
  color: #BBBBBB;
  margin-top: 4rpx;
  display: block;
}

.empty-state {
  padding: 70rpx 32rpx;
  text-align: center;
}
.empty-icon {
  font-size: 90rpx;
  opacity: 0.2;
  display: block;
  margin-bottom: 12rpx;
}
.empty-text {
  font-size: 27rpx;
  color: #CCCCCC;
  display: block;
}

/* ===== Emoji 选择器 ===== */
.emoji-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #FFFFFF;
  padding: 28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  z-index: 1001;
  box-shadow: 0 -8rpx 32rpx rgba(0,0,0,0.08);
}
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}
.emi-item {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
}
