/* pages/add-event/add-event.wxss */

.form-card {
  background: var(--bg-white);
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.form-group {
  margin-bottom: 36rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.label-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.required {
  color: var(--color-danger);
  margin-left: 4rpx;
}

/* ===== 日期选择器 + 农历展示 ===== */
.date-picker-wrapper {
  width: 100%;
}

.picker-value {
  height: 80rpx;
  background: #F8F8F8;
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.picker-value.placeholder {
  color: var(--text-tertiary);
}

.lunar-display {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #FFF5EE 0%, #FFF0F5 100%);
  border-radius: var(--radius-sm);
  border-left: 4rpx solid var(--color-primary);
}

.lunar-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.lunar-animal {
  font-size: 32rpx;
}

.lunar-date-text {
  font-size: 26rpx;
  color: #8B4513;
  font-weight: 500;
}

.highlight-tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8C69);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 500;
  border-radius: 20rpx;
  margin-left: auto;
}

.hidden {
  display: none !important;
}

.lunar-detail {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.tag-item {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  line-height: 1.4;
}

.tag-term {
  background: #E3F2FD;
  color: #1565C0;
}

.tag-major {
  background: #FFEBEE;
  color: #C62828;
}

.tag-holiday {
  background: #FFF3E0;
  color: #E65100;
}

.tag-traditional {
  background: #F3E5F5;
  color: #7B1FA2;
}

.tag-special {
  background: #E8F5E9;
  color: #2E7D32;
}

.tag-funny {
  background: #FFFDE7;
  color: #F9A825;
}

.lunar-ganzhi {
  font-size: 22rpx;
  color: #999;
}

/* ===== 提醒设置 ===== */
.reminder-setting {
  background: #FAFAFA;
  border-radius: var(--radius-md);
  padding: 24rpx;
}

.reminder-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.reminder-switch {
  width: 80rpx;
  height: 44rpx;
  background: #DDDDDD;
  border-radius: 22rpx;
  position: relative;
  transition: all 0.3s;
  flex-shrink: 0;
}

.reminder-switch.active {
  background: var(--color-primary);
}

.switch-dot {
  width: 38rpx;
  height: 38rpx;
  background: #FFFFFF;
  border-radius: 50%;
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  transition: left 0.3s;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
}

.reminder-switch.active .switch-dot {
  left: 39rpx;
}

.reminder-title {
  font-size: 26rpx;
  color: var(--text-primary);
}

.reminder-days {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EEEEEE;
}

.reminder-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
}

.days-scroll {
  white-space: nowrap;
}

.days-list {
  display: inline-flex;
  gap: 12rpx;
}

.day-chip {
  display: inline-flex;
  padding: 10rpx 22rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E0E0;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  transition: all 0.2s;
}

.day-chip.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #FFFFFF;
}

.reminder-note {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: #FFFBF0;
  border-radius: var(--radius-sm);
}

.note-icon {
  font-size: 26rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.note-text {
  font-size: 22rpx;
  color: #997A3D;
  line-height: 1.5;
}

/* ===== 其他表单元素 ===== */
.form-input {
  height: 80rpx;
  background: #F8F8F8;
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.type-selector {
  display: flex;
  gap: 20rpx;
}

.type-option {
  flex: 1;
  padding: 24rpx;
  background: #F8F8F8;
  border-radius: var(--radius-md);
  text-align: center;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.type-option.active {
  background: #FF8C6920;
  border-color: var(--color-primary);
}

.type-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 8rpx;
}

.type-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
}

.type-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
  display: block;
}

.manage-link {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--color-primary);
}

.manage-link .arrow {
  margin-left: 4rpx;
  font-size: 28rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 16rpx;
  background: #F8F8F8;
  border-radius: var(--radius-sm);
  border: 2rpx solid transparent;
  min-width: 120rpx;
}

.category-item.active {
  background: #FF8C6920;
  border-color: var(--color-primary);
}

.category-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.category-name {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: #F8F8F8;
  border-radius: var(--radius-sm);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.btn-group {
  padding: 0 0 48rpx;
}

.save-btn {
  margin-bottom: 20rpx;
}

.cancel-btn {
  background: var(--bg-white);
  color: var(--text-secondary);
  border: 2rpx solid #E0E0E0;
}

.cancel-btn::after {
  border: none;
}
