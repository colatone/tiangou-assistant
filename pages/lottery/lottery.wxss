/* pages/lottery/lottery.wxss — 浅色主题（仿潮汐页） */
page { background: #FFF8F0; }

.page-lottery {
  min-height: 100vh;
  padding: 0;
  background: #FFF8F0;
}

/* ===== 奖项状态条 ===== */
.prize-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 28rpx 8rpx;
  flex-wrap: wrap;
}
.ps-label { font-size: 24rpx; color: #999999; flex-shrink: 0; }
.ps-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(255,140,105,0.2);
  border-radius: 24rpx;
  padding: 6rpx 18rpx;
}
.ps-chip.done { opacity: 0.45; text-decoration: line-through; }
.ps-chip.active {
  background: linear-gradient(135deg, #FF8C69, #FF6B4A);
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(255,107,74,0.35);
}
.ps-chip.active .ps-name,
.ps-chip.active .ps-rem { color: #FFFFFF; }
.ps-chip.active .ps-icon { filter: none; }
.ps-icon { font-size: 26rpx; }
.ps-name { font-size: 24rpx; color: #555555; font-weight: 500; }
.ps-rem { font-size: 20rpx; color: #FF8C69; }

/* ===== 中央舞台 ===== */
.stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 4rpx;
}

.canvas-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(255,140,105,0.08);
  overflow: hidden;
}
/* 结果弹窗时隐藏画布，彻底避免原生 canvas 覆盖弹窗 */
.canvas-card.is-hidden {
  display: none;
}

/* ===== 多阶段按钮 ===== */
.draw-btn {
  margin-top: 28rpx;
  width: 80% !important;
  max-width: 520rpx;
  height: 88rpx !important;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #FF8C69, #FF6B4A) !important;
  color: #FFFFFF !important;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 30rpx rgba(255,107,74,0.3);
  border: none !important;
}
.draw-btn::after { border: none; }
.draw-btn:active { transform: scale(0.97); opacity: 0.9; }

.gear-btn {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #BBBBBB;
  background: rgba(0,0,0,0.03);
  border-radius: 50%;
}

/* ===== 结果弹窗（纯白卡片，不透出canvas） ===== */
.result-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.result-card {
  width: 580rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx 36rpx 40rpx;
  box-shadow: 0 16rpx 56rpx rgba(0,0,0,0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 奖项标题头——放大2倍 */
.res-prize-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 44rpx;
  border-radius: 36rpx;
  border: 2rpx solid;
  margin-bottom: 36rpx;
}
.res-picon { font-size: 56rpx; }           /* 原34→56 */
.res-pname {
  font-size: 40rpx;                          /* 原28→40 */
  font-weight: 800;
}

/* 抽取者列表——居中布局 */
.res-winners {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.res-winner-item {
  display: flex;
  align-items: center;
  justify-content: center;                   /* 居中 */
  gap: 16rpx;
  padding: 20rpx 48rpx;
  background: #FAFAFA;
  border-radius: 18rpx;
  min-width: 320rpx;
}
.res-wdot {
  width: 28rpx;                              /* 原24→28 */
  height: 28rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.res-wname {
  font-size: 38rpx;                          /* 原32→38 */
  font-weight: 800;
}

.res-hint { font-size: 27rpx; color: #AAAAAA; margin-bottom: 32rpx; }
.res-btns { display: flex; gap: 20rpx; width: 100%; }
.btn-close {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #F5F5F5 !important;
  color: #666666 !important;
  border-radius: 40rpx;
  font-size: 29rpx;
  border: none !important;
}
.btn-close::after { border: none; }
.btn-again {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #FF8C69, #FF6B4A) !important;
  color: #FFF !important;
  border-radius: 40rpx;
  font-size: 29rpx;
  font-weight: 600;
  border: none !important;
  box-shadow: 0 4rpx 16rpx rgba(255,107,74,0.3);
}
.btn-again::after { border: none; }

/* ===== 记录区 ===== */
.section-card {
  margin: 24rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
}
.sec-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; flex-wrap: wrap; gap: 8rpx; }
.sec-title { font-size: 30rpx; font-weight: 600; color: #333333; }
.sec-actions { display: flex; gap: 24rpx; flex-shrink: 0; }
.link { font-size: 26rpx; color: #FF8C69; font-weight: 500; }
.link.danger { color: #FF6B6B; }
.link.warn { color: #E6A23C; }

.rec-item { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #F0F0F0; }
.rec-item:last-child { border-bottom: none; }
.rec-icon { font-size: 36rpx; margin-right: 16rpx; }
.rec-body { flex: 1; min-width: 0; }
.rec-name { font-size: 28rpx; font-weight: 600; color: #333333; display: block; }
.rec-meta { font-size: 22rpx; color: #BBBBBB; margin-top: 4rpx; display: block; }
.rec-more { text-align: center; padding: 24rpx 0 8rpx; font-size: 26rpx; color: #FF8C69; }

.empty-state { padding: 70rpx 32rpx; text-align: center; }
.empty-icon { font-size: 90rpx; opacity: 0.25; display: block; margin-bottom: 14rpx; }
.empty-text { font-size: 28rpx; color: #CCCCCC; display: block; }
.empty-sub { font-size: 24rpx; color: #DDDDDD; display: block; margin-top: 8rpx; }

.tabbar-placeholder { height: calc(100rpx + env(safe-area-inset-bottom)); }
.export-canvas { position: fixed; left: -9999px; top: -9999px; width: 600px; height: 1200px; }
