/* pages/tide/tide.wxss */

.page-tide {
  min-height: 100vh;
  background: #FFF8F0;
  box-sizing: border-box;
  padding-bottom: 120rpx;
}

/* ===== 紧凑头部卡片（站点 + 切换 + 日期 合一） ===== */
.tide-header-card {
  background: #FFFFFF;
  padding: 20rpx 28rpx 16rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.station-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.station-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary, #333);
  letter-spacing: 1rpx;
}

.dist-badge {
  font-size: 20rpx;
  color: #FF8C69;
  background: rgba(255, 140, 105, 0.1);
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

/* 视图切换（紧凑药丸） */
.view-switch {
  display: flex;
  background: #F5F3F0;
  border-radius: 28rpx;
  padding: 4rpx;
}

.switch-btn {
  font-size: 22rpx;
  color: var(--text-secondary, #999);
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.switch-btn.active {
  background: #FFFFFF;
  color: #FF8C69;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

/* ===== 日期选择条 ===== */
.date-bar {
  display: flex;
  gap: 8rpx;
  overflow-x: auto;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.date-bar::-webkit-scrollbar { display: none; }

.date-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 80rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  background: #F5F5F5;
  transition: all 0.2s;
  flex-shrink: 0;
}

.date-item.active {
  background: linear-gradient(135deg, #FF8C69, #FF6B4A);
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 105, 0.25);
}

.date-item.active .date-weekday,
.date-item.active .date-day {
  color: #FFFFFF !important;
}

.date-weekday {
  font-size: 18rpx;
  color: var(--text-tertiary, #BBB);
  margin-bottom: 2rpx;
}

.date-day {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary, #333);
}

.date-item.active .date-day {
  font-weight: 700;
}

/* ===== 加载 / 错误 / 空状态 ===== */
.loading-mask {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-secondary, #666);
}

.error-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx;
}

.error-hint .error-text {
  font-size: 26rpx;
  color: #E53935;
  text-align: center;
  margin-bottom: 24rpx;
}

.retry-btn {
  background: #FF8C69;
  color: #FFFFFF;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.empty-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-tertiary, #999);
}

/* 底部导航栏占位 */
.tabbar-placeholder {
  height: 100rpx;
}
